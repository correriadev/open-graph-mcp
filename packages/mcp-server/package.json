{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@open-graph-mcp/mcp-server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun run --cwd ../.. test",
    "test:load": "bun test/load/presence-load.ts",
    "test:soak": "bun test/load/presence-load.ts --soak",
    "test:storm": "bun test/load/presence-load.ts --storm",
    "test:client-contract": "bun test/mcp-client-contract.ts",
    "test:probes:deterministic": "bun test test/probes/concurrency-probe.test.ts test/probes/cancellation-probe.test.ts test/probes/cancellation-duplicate-effect.test.ts test/probes/scale-probe.test.ts",
    "probe:concurrency": "bun test/probes/concurrency-probe.ts --run",
    "probe:cancellation": "bun test/probes/cancellation-probe.ts --run",
    "probe:scale": "bun test/probes/scale-probe.ts --run"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@open-graph-mcp/graph-core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.13"
  }
}
