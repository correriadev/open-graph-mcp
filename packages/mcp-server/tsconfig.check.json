{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "paths": {
      "@open-graph-mcp/graph-core/*": ["../graph-core/src/*"],
      "@open-graph-mcp/client": ["../client/src/index.ts"],
      "@open-graph-mcp/client/*": ["../client/src/*"]
    }
  },
  "include": ["src", "test"]
}
