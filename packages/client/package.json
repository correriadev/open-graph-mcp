{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@open-graph-mcp/client",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node-store": {
      "bun": "./src/node-store.ts",
      "development": "./src/node-store.ts",
      "types": "./dist/node-store.d.ts",
      "import": "./dist/node-store.js"
    }
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test --timeout 30000",
    "test:node": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "@types/node": "22.10.2",
    "typescript": "5.8.2"
  }
}
