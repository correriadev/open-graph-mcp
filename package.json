{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "open-graph-mcp",
  "description": "Serviço MCP de knowledge graph governado — derivado dos conceitos do open-graph",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": ["packages/*"]
  },
  "scripts": {
    "dev": "bun run --cwd packages/mcp-server dev",
    "dev:web": "bun run --cwd packages/mcp-web dev",
    "test": "bun test",
    "verify": "bun run typecheck && bun run test",
    "typecheck": "bun scripts/verification/typecheck-gate.ts",
    "typecheck:update": "bun scripts/verification/typecheck-gate.ts --update",
    "typecheck:strict": "bun scripts/verification/typecheck-gate.ts --strict"
  },
  "devDependencies": {
    "typescript": "5.8.2"
  }
}
